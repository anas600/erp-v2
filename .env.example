# ============================================================
# ERP-V2 Environment Configuration
# Copy to .env and edit as needed
# ============================================================

# ---- PostgreSQL ----
# Accepts: 15 or 17 (any version available locally or via Docker)
POSTGRES_VERSION=17
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_secret
POSTGRES_PORT=5432

# ---- Backend (.NET) ----
BACKEND_PORT=5000
JWT_KEY=change-this-in-production-use-a-long-random-secret-at-least-32-characters
JWT_ISSUER=erp-v2
JWT_AUDIENCE=erp-v2-client
JWT_EXPIRY_MINUTES=1440
CORS_ORIGINS=http://localhost:3000
# Tell .NET to use polling instead of inotify for file watchers.
# Required for containers (Render free tier hits the 128-instance inotify limit).
DOTNET_USE_POLLING_FILE_WATCHER=true
# Same idea for Next.js (in case the dev server ever runs in this container).
WATCHPACK_POLLING=true

# ---- Frontend (Next.js) ----
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000
